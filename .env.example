# --- App ---
ENVIRONMENT=development
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Supabase (Postgres + Auth + Realtime + pgvector) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=                    # direct Postgres connection string for SQLAlchemy/LangGraph

# --- Redis / ARQ ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- CORS ---
FRONTEND_ORIGIN=https://your-frontend.vercel.app

# --- TLS / certbot (leave blank for local dev) ---
DOMAIN=
CERTBOT_EMAIL=

# --- LLM: Groq (active provider — free tier) ---
GROQ_API_KEY=
LLM_DEFAULT_MODEL=openai/gpt-oss-120b
LLM_REPORTING_MODEL=openai/gpt-oss-120b
LLM_FAST_MODEL=openai/gpt-oss-20b

# --- LLM: Anthropic (future — not active yet) ---
ANTHROPIC_API_KEY=

# --- Embeddings (stub until Voyage AI key provided) ---
VOYAGEAI_API_KEY=
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIMENSION=1024

# --- Circuit breakers ---
VULN_ANALYSIS_ITERATION_CAP=10
EXPLOITATION_ITERATION_CAP=20
VULN_ANALYSIS_TOKEN_CEILING=100000
EXPLOITATION_TOKEN_CEILING=200000
